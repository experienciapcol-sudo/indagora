# Copiar a .dev.vars para desarrollo local con wrangler. Nunca versionar .dev.vars.
# En producción: npx wrangler secret put META_API_KEY

META_API_KEY=

# Se confirma en la documentación de dev.meta.ai durante el smoke test.
META_API_BASE_URL=https://api.meta.ai/v1

# Nombres de modelo: se confirman con GET {META_API_BASE_URL}/models.
MODEL_AGENT=muse-spark-1.3
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0

# Modo demostración: reproduce corridas reales grabadas, sin costo ni clave.
DEMO_MODE=false
