{
  // Worker (Cloudflare Workers + Hono). Tipos del runtime: `npm run cf-typegen`.
  // Sin tipos de Node, para que el código del Worker no use APIs que no existen ahí.
  // Las pruebas y sus ayudantes se revisan con tsconfig.pruebas.json.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "types": ["./worker-configuration.d.ts", "vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/worker", "src/config", "worker-configuration.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/worker/gasto/d1-falsa.ts"]
}
